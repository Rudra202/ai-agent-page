# Copy to server/.env and fill in. server/.env is git-ignored. Never commit it.

PORT=4000
NODE_ENV=development
# The website's address, exactly as the browser shows it (scheme, host and port, no path). Several can be listed, separated
# by commas. In development the localhost / 127.0.0.1 twin of a local address is accepted too, on the same port. No wildcards.
CLIENT_ORIGIN=http://localhost:5173

# Auth. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 random characters in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# MongoDB Atlas. Either set a full connection string in MONGODB_URI,
# or set user, password and host and the URI is built for you (password is URL-encoded).
# With neither, the server runs on an in-memory store that loses data on restart (development only).
MONGODB_URI=
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_DB_NAME=tajir
MONGODB_APP_NAME=tajir-ai

# The AI assistant. "auto" (default) tries Gemini first (if GEMINI_API_KEY is set), then OpenAI (if OPENAI_API_KEY is
# set), then falls back to built-in rules that only follow the guided flows and cannot answer general questions.
# AI_PROVIDER can also be "gemini" or "openai" (use only that one) or "rules" (never use a model).
AI_PROVIDER=auto
# Get a Gemini key at https://aistudio.google.com/apikey. Put keys here only. Never commit them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried if the model above is overloaded or down (before OpenAI). Leave empty to turn it off.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Per-attempt timeout, retries for transient failures, and the cap on the structured reply.
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1500

# File storage. "gridfs" (default) keeps uploaded documents in MongoDB (GridFS bucket "tajir_documents", same Atlas database,
# no extra service). "local" keeps them on this server's disk in UPLOAD_DIR. Documents that are already on local disk
# stay readable whichever you choose. There is no cloud object storage.
STORAGE_PROVIDER=gridfs
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Reading scanned PDFs and photos of documents with local OCR (Tesseract, no cloud). Text PDFs work with OCR off.
DOCUMENT_OCR_ENABLED=true
# Asking an AI model for structured details (trade licence number, expiry, ...). Reading and OCR work without it.
DOCUMENT_AI_ENABLED=true
# Documents are queued in MongoDB (no Redis). How many are read at once, how many tries each gets, and the first retry delay.
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_JOB_ATTEMPTS=3
DOCUMENT_JOB_BACKOFF_MS=5000

# Optional overrides. Defaults: cookies are Secure in production; simulation is off in production.
COOKIE_SECURE=
SIMULATION_ENABLED=
TRUST_PROXY=0
